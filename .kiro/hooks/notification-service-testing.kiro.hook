{
  "enabled": true,
  "name": "Notification Service API Testing",
  "description": "Automatically runs Postman collection tests for Notification Service when Java files or configuration files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "notification-service/**/*.java",
      "notification-service/src/main/resources/application.properties",
      "notification-service/pom.xml",
      "api-gateway/src/main/java/com/omnicharge/gateway/config/GatewayConfig.java"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Notification Service code has been modified. Please run the Postman collection tests for the Notification Service and show me the results. If there are any test failures, analyze them and propose fixes."
  }
}
