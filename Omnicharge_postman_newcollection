{
  "info": {
    "name": "Omnicharge_postman_collection",
    "description": "Comprehensive Postman Collection covering all OmniCharge flows: User Registration, Google Auth, Profile Completion Enforcement, Operator/Plan Browsing, Recharge, Payment (Razorpay), Notifications, and Admin operations.\n\nRun requests sequentially from top to bottom. Variables are auto-populated via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flow A: Standard Registration & Login",
      "item": [
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"testuser@omnicharge.com\",\n  \"password\": \"SecurePass123!\",\n  \"mobileNumber\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.refreshToken);",
                  "    pm.collectionVariables.set('user_id', jsonData.data.fullName ? '' : '');",
                  "    pm.collectionVariables.set('is_profile_complete', jsonData.data.isProfileComplete);",
                  "",
                  "    var payload = JSON.parse(atob(jsonData.data.accessToken.split('.')[1]));",
                  "    pm.collectionVariables.set('user_id', payload.userId);",
                  "",
                  "    console.log('Login OK | userId=' + payload.userId + ' | profileComplete=' + jsonData.data.isProfileComplete);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@omnicharge.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
